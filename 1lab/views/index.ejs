<div class="row">
    <div class="col-md-3">
        <h4>Фильтры</h4>
        <form action="/" method="GET" class="mb-4">
            <div class="mb-3">
                <label class="form-label">Статус</label>
                <select name="status" class="form-select">
                    <option value="">Все</option>
                    <% statuses.forEach(s => { %>
                        <option value="<%= s.id %>" <%= filters.status == s.id ? 'selected' : '' %>><%= s.name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Предмет</label>
                <select name="subject" class="form-select">
                    <option value="">Все</option>
                    <% subjects.forEach(s => { %>
                        <option value="<%= s.id %>" <%= filters.subject == s.id ? 'selected' : '' %>><%= s.name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="mb-3">
                <label class="form-label">Сортировка</label>
                <select name="sort" class="form-select">
                    <option value="deadline_asc" <%= filters.sort === 'deadline_asc' ? 'selected' : '' %>>Сначала срочные</option>
                    <option value="deadline_desc" <%= filters.sort === 'deadline_desc' ? 'selected' : '' %>>Сначала несрочные</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary w-100">Применить</button>
            <a href="/" class="btn btn-secondary w-100 mt-2">Сбросить</a>
        </form>
    </div>

    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>Список задач</h4>
            <a href="/tasks/new" class="btn btn-success">Добавить задачу</a>
        </div>

        <% if (tasks.length === 0) { %>
            <div class="alert alert-info">Задачи не найдены.</div>
        <% } else { %>
            <% tasks.forEach(task => { %>
                <div class="card mb-3">
                    <div class="card-body">
                        <h5 class="card-title"><%= task.title %></h5>
                        <h6 class="card-subtitle mb-2 text-muted">
                            Дедлайн: <%= task.deadline ? task.deadline : 'Не указан' %> | 
                            Статус: <%= task.status_name || 'Без статуса' %> |
                            Предмет: <%= task.subject_name || 'Не указан' %> |
                            Категория: <%= task.category_name || 'Не указана' %>
                        </h6>
                        <p class="card-text"><%= task.note %></p>
                        
                        <% if (task.files && task.files.length > 0) { %>
                            <div class="mb-3">
                                <strong>Прикрепленные файлы:</strong>
                                <ul class="list-unstyled">
                                <% task.files.forEach(file => { %>
                                    <li><a href="/uploads/<%= file.file_name %>" target="_blank"><%= file.original_file_name %></a></li>
                                <% }) %>
                                </ul>
                            </div>
                        <% } %>

                        <div class="d-flex gap-2">
                            <a href="/tasks/<%= task.id %>/edit" class="btn btn-sm btn-outline-primary">Редактировать</a>
                            <form action="/tasks/<%= task.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Удалить задачу?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>
